{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Atamo.Samples.Hello",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/samples/Atamo.Samples.Hello/bin/Debug/net9.0/Atamo.Samples.Hello.dll",
      "args": [],
      "cwd": "${workspaceFolder}/samples/Atamo.Samples.Hello",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Debug Atamo.Tests",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Atamo.sln",
        "--no-build",
        "--logger",
        "console;verbosity=detailed"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
